{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/board.schema.json",
  "title": "Project Task Board",
  "description": "Machine-readable source of truth for tasks, dependencies and write scopes. STATUS.md is generated from it. Schema 1.0 adds stages, packages, resources, budgets, worktrees and contracts; 1.1 adds the optional task fields labels and estimate_hours; 1.2 adds the optional planning dates planned_start and target. tools/check.py enforces the version rules (a versioned field on a board without the matching schema_version is an error).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "profile",
    "base_branch",
    "tasks"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "S",
        "M",
        "L"
      ]
    },
    "base_branch": {
      "type": "string",
      "default": "main",
      "minLength": 1
    },
    "generator_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Generator version the project was created or last migrated with (VERSION file of the package)."
    },
    "stage": {
      "type": "integer",
      "minimum": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ],
      "description": "Omit for a 0.9 board. '1.0' allows stages, packages, resources, budgets, worktrees, contracts and the extra task fields; '1.1' adds labels and estimate_hours; '1.2' adds planned_start and target. tools/check.py rejects versioned fields on a board without the matching schema_version."
    },
    "worktrees": {
      "enum": [
        "required",
        "recommended",
        "off"
      ],
      "description": "Where task work happens. Default: required for M/L, off for S (PL-05). With 'required' a worker write in the main checkout is denied while its task has a worktree."
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      },
      "description": "Stages with exit criteria and an owner decision (PL-08). Task.stage may reference stages[].id instead of using an integer."
    },
    "packages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/package"
      },
      "description": "Packages, services, apps and tools of a monorepo (profile L, PL-06); may_import feeds the boundaries gate (PL-07)."
    },
    "resources": {
      "$ref": "#/$defs/resources",
      "description": "Runtime resources: slots, port formula, service offsets, infra-failure patterns (PL-02, PL-03)."
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "description": "Overrides of the profile-dependent word budgets (PL-09). Every override needs a reason.",
      "properties": {
        "architecture": {
          "$ref": "#/$defs/budget"
        },
        "agents": {
          "$ref": "#/$defs/budget"
        },
        "status": {
          "$ref": "#/$defs/budget"
        },
        "brief": {
          "$ref": "#/$defs/budget"
        },
        "package_architecture": {
          "$ref": "#/$defs/budget"
        },
        "package_agents": {
          "$ref": "#/$defs/budget"
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/contract"
      },
      "description": "Machine-readable contracts: JSON Schemas, fixtures, versions and dependants (PL-12)."
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "goal",
        "status",
        "depends_on",
        "complexity",
        "stage",
        "scope_write",
        "acceptance",
        "gates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(M[0-9]{2,3}|[A-Z][A-Z0-9]{0,5}-[0-9]{2,3})$",
          "description": "0.9 boards allow M##/M###; a 1.0 board also allows P3-02, ENG-14 (prefix 1-6 characters, then -NN)."
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "goal": {
          "type": "string",
          "minLength": 3
        },
        "why": {
          "type": "string"
        },
        "satisfies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^D[0-9]+$"
          },
          "uniqueItems": true,
          "description": "Definition-of-done items from docs/quality.md (D1, D2 …) this task contributes to."
        },
        "status": {
          "enum": [
            "pending",
            "claimed",
            "in_progress",
            "verifying",
            "review",
            "rework",
            "done",
            "blocked",
            "failed"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "complexity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "stage": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1
            }
          ],
          "description": "Stage number (classic) or a stages[].id (1.0)."
        },
        "parallel_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope_write": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "scope_read": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths that may be read. Writing is only allowed if the path is also in scope_write."
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "evidence": {
          "description": "Paths of tools/gate.py records (reviews/evidence/*.json), one passing record per gate; required once status is done. Free text is accepted with a warning for older projects.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope_write_forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths that may be read but explicitly must not be written."
        },
        "handoff": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 200
          },
          "description": "Up to 3 short lines for the tasks that depend on this one (decision, pitfall, changed interface). Written when the task is done."
        },
        "package": {
          "type": "string",
          "minLength": 1,
          "description": "Folder of the package/service/app this task belongs to; must be one of packages[].path (1.0)."
        },
        "labels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,40}$"
          },
          "description": "Label ids defined in dashboard.json (1.1). Labels group and filter work; they never change the write scope."
        },
        "estimate_hours": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "description": "Planning estimate in hours (1.1). The dashboard worklog compares it with the actual run and session time."
        },
        "planned_start": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Optional planned start date (1.2), YYYY-MM-DD. The timeline uses it instead of the auto-schedule for this task."
        },
        "target": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Optional target date (1.2), YYYY-MM-DD; must not be before planned_start. The timeline uses it to size the bar."
        },
        "exclusive": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Resources this task's gates must hold exclusively, e.g. ['e2e'] (PL-03)."
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Named runtime resources the gates need, e.g. ['ports', 'db', 'bucket'] (PL-02)."
        },
        "claim": {
          "$ref": "#/$defs/claim",
          "description": "Live cross-harness claim, written only by tooling (PL-04); never edited by hand."
        },
        "contract_followups": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Contract dependants a task does not update itself, approved by the lead (PL-12)."
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "id",
        "title"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^ADR-[0-9]{3,4}$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "file": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q[0-9]+$"
        },
        "question": {
          "type": "string",
          "minLength": 3
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "open",
            "answered",
            "dropped"
          ]
        },
        "answer": {
          "type": "string"
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "goal": {
          "type": "string"
        },
        "exit_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exit_gates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "owner_decision": {
          "enum": [
            "pending",
            "continue",
            "stop"
          ],
          "default": "pending"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "package",
            "service",
            "app",
            "tool",
            "infra"
          ]
        },
        "may_import": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slots": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "port_base": {
          "type": "integer",
          "minimum": 1,
          "default": 4000
        },
        "port_stride": {
          "type": "integer",
          "minimum": 1,
          "default": 100
        },
        "services": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Port offset per service name: port = port_base + port_stride·slot + offset."
        },
        "infra_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Output patterns that mark a failed gate as an infrastructure failure, not a test failure (PL-03)."
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "limit",
        "reason"
      ],
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "task": {
          "type": "string"
        },
        "harness": {
          "enum": [
            "dsh",
            "claude-code",
            "cli"
          ]
        },
        "session": {
          "type": "string"
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ]
        },
        "slot": {
          "type": [
            "integer",
            "null"
          ]
        },
        "started": {
          "type": "string"
        },
        "heartbeat": {
          "type": "string"
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "path",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "schema_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fixtures_dir": {
          "type": "string"
        },
        "dependants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
