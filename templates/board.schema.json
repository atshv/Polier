{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/board.schema.json",
  "title": "Project Task Board",
  "description": "Machine-readable source of truth for tasks, dependencies and write scopes. STATUS.md is generated from it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "profile",
    "base_branch",
    "tasks"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "enum": [
        "S",
        "M",
        "L"
      ]
    },
    "base_branch": {
      "type": "string",
      "default": "main",
      "minLength": 1
    },
    "stage": {
      "type": "integer",
      "minimum": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "goal",
        "status",
        "depends_on",
        "complexity",
        "stage",
        "scope_write",
        "acceptance",
        "gates"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M[0-9]{2,3}$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "goal": {
          "type": "string",
          "minLength": 3
        },
        "why": {
          "type": "string"
        },
        "satisfies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^D[0-9]+$"
          },
          "uniqueItems": true,
          "description": "Definition-of-done items from docs/quality.md (D1, D2 …) this task contributes to."
        },
        "status": {
          "enum": [
            "pending",
            "claimed",
            "in_progress",
            "verifying",
            "review",
            "rework",
            "done",
            "blocked",
            "failed"
          ]
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "complexity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "stage": {
          "type": "integer",
          "minimum": 1
        },
        "parallel_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope_write": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "scope_read": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths that may be read. Writing is only allowed if the path is also in scope_write."
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "gates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "worktree": {
          "type": [
            "string",
            "null"
          ]
        },
        "round": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "evidence": {
          "description": "Gate output or paths to it; required once status is done.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scope_write_forbidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Paths that may be read but explicitly must not be written."
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "id",
        "title"
      ],
      "properties": {
        "date": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^ADR-[0-9]{3,4}$"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "file": {
          "type": "string"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^Q[0-9]+$"
        },
        "question": {
          "type": "string",
          "minLength": 3
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "open",
            "answered",
            "dropped"
          ]
        },
        "answer": {
          "type": "string"
        }
      }
    }
  }
}
