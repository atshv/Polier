{
  "name": "dsh-polier",
  "version": "1.1.0",
  "description": "Polier for DeepSeek Harness: plans an AI coding project, then keeps the agents to the plan. Enforces task scopes, records gate evidence and checks the board.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atshv/polier.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agents",
    "planning",
    "polier"
  ],
  "type": "module",
  "main": "adapters/dsh/index.mjs",
  "exports": {
    ".": "./adapters/dsh/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "adapters/dsh/index.mjs",
    "adapters/dsh/lib/",
    "adapters/claude-code/hook.py",
    "adapters/claude-code/settings.example.json",
    "adapters/claude-code/README.md",
    "core/*.py",
    "cordis.patch.yml",
    "SKILL.md",
    "VERSION",
    "CHANGELOG.md",
    "prompt/",
    "templates/",
    "tools/*.py",
    "tools/manifest.json",
    "guide/",
    "examples/"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3"
  },
  "scripts": {
    "test": "node --test adapters/dsh/test/*.test.mjs && python3 -m unittest discover -s tests && python3 -m unittest discover -s core/tests -t . && python3 -m unittest discover -s adapters/claude-code/tests"
  }
}
