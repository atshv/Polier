{
  "name": "dsh-polier",
  "version": "2.6.0",
  "description": "Plans an AI coding project before the first line of code, then keeps the agents to the plan: write guard per task, recorded test evidence, checkpoints, approvals and an optional local dashboard with headless agent sessions. DeepSeek Harness plugin with Claude Code hooks and an MCP server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atshv/polier.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agents",
    "planning",
    "polier",
    "dashboard",
    "mcp"
  ],
  "type": "module",
  "main": "adapters/dsh/index.mjs",
  "exports": {
    ".": "./adapters/dsh/index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "adapters/dsh/index.mjs",
    "adapters/dsh/lib/",
    "adapters/claude-code/hook.py",
    "adapters/claude-code/settings.example.json",
    "adapters/claude-code/README.md",
    "core/*.py",
    "cordis.patch.yml",
    "SKILL.md",
    "VERSION",
    "CHANGELOG.md",
    "prompt/",
    "templates/",
    "tools/*.py",
    "tools/manifest.json",
    "guide/",
    "examples/",
    "server/*.py",
    "server/assets/*",
    "server/handbook/",
    "templates/dashboard.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.3",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3"
  },
  "scripts": {
    "test": "node --test adapters/dsh/test/*.test.mjs && python3 -m unittest discover -s tests && python3 -m unittest discover -s core/tests -t . && python3 -m unittest discover -s adapters/claude-code/tests"
  }
}
