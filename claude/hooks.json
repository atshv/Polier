{
  "description": "Polier: live context, write and command guard, stop check. Silent outside a Polier project.",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/claude/hook.mjs", "SessionStart"], "timeout": 30 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/claude/hook.mjs", "UserPromptSubmit"], "timeout": 30 }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/claude/hook.mjs", "SubagentStart"], "timeout": 30 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit|Bash)$|^mcp__(plugin_polier_)?polier__pl_",
        "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/claude/hook.mjs", "PreToolUse"], "timeout": 30 }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/claude/hook.mjs", "Stop"], "timeout": 90 }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["${CLAUDE_PLUGIN_ROOT}/claude/hook.mjs", "SubagentStop"], "timeout": 90 }] }
    ]
  }
}
