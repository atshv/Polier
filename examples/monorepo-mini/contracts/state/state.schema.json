{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canvas-mini.example.com/contracts/state/1.0.0/state.schema.json",
  "title": "Canvas document state",
  "description": "The document state exchanged between the engine, the UI kit, the sync service and the web app. Version 1.0.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "documentId",
    "nodes",
    "edges",
    "viewport",
    "updatedAt"
  ],
  "properties": {
    "contract": {
      "const": "state",
      "description": "Contract name; protects against messages of another contract."
    },
    "version": {
      "const": "1.0.0",
      "description": "Must equal contracts[].version in board.json and the version in $id."
    },
    "documentId": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "viewport": {
      "$ref": "#/$defs/viewport"
    },
    "updatedAt": {
      "type": "string",
      "description": "ISO 8601 UTC timestamp of the last accepted change."
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "x",
        "y",
        "width",
        "height",
        "rotation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["rect", "ellipse", "text", "frame"]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        },
        "rotation": {
          "type": "number"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
